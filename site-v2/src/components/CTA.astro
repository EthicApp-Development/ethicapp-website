---
const { label } = Astro.props;
---
<section class="mx-auto max-w-6xl px-6 py-12">
  <div class="rounded-2xl bg-indigo-700 p-8 text-center text-white">
    <h3 class="text-2xl font-bold">{label}</h3>
    <a class="mt-4 inline-block rounded-lg bg-white px-5 py-3 font-medium text-indigo-700" href="https://github.com/EthicApp-Development/organization" target="_blank" rel="noreferrer">GitHub</a>
  </div>
</section>
