---
import ScreenshotSequence from './ScreenshotSequence.astro';
import { teacherShowcase } from '../lib/showcase';
import type { Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
  title: string;
  body: string;
  accessLabel: string;
  accessHref: string;
}
const { locale, title, body, accessLabel, accessHref } = Astro.props;
---
<section id="inicio" class="mx-auto max-w-7xl bg-cover bg-center bg-no-repeat px-6 py-12 lg:py-16">
  <div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:items-center">
    <div class="min-w-0">
      <h1 class="max-w-xl text-4xl font-bold leading-tight lg:text-5xl">{title}</h1>
      <p class="mt-4 text-lg text-slate-600">{body}</p>
      {accessLabel && accessHref ? (
        <p class="mt-6">
          <a
            class="inline-flex items-center rounded-md bg-white px-5 py-3 text-sm font-semibold !text-blue-700 shadow-sm transition hover:bg-slate-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
            href={accessHref}
          >
            {accessLabel}
          </a>
        </p>
      ) : null}
    </div>
    <ScreenshotSequence
      locale={locale}
      slides={teacherShowcase(locale)}
      label={locale === 'es' ? 'Recorrido por la interfaz docente de EthicApp' : 'A tour of the EthicApp teacher interface'}
      variant="hero"
    />
  </div>
</section>
