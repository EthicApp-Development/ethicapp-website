---
const { label } = Astro.props;
---
<section id="footer" class="mx-auto max-w-6xl px-6 py-12">
  <div class="rounded-lg bg-blue-700 p-8 text-white">
    
    <div class="flex flex-wrap items-center justify-center gap-8">
      
      <a href="https://ing.uandes.cl" target="_blank" rel="noreferrer">
        <img 
          src="/assets/institutions/uandes-ing-logo.png"
          alt="ING Universidad de los Andes"
          class="h-16 object-contain"
        />
      </a>

      <a href="https://fen.uchile.cl" target="_blank" rel="noreferrer">
        <img 
          src="/assets/institutions/uchile-eco-logo.png"
          alt="FEN Universidad de Chile"
          class="h-16 object-contain"
        />
      </a>

      <a href="https://github.com/EthicApp-Development/organization" target="_blank" rel="noreferrer">
        <img 
          src="/assets/github-logo-white.svg"
          alt="GitHub"
          class="h-16 object-contain"
        />
      </a>

    </div>

  </div>
</section>
