---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TopNav from '../../components/TopNav.astro';
import { copy, locales, type Locale } from '../../lib/i18n';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params;
if (!locale || !locales.includes(locale as Locale)) return Astro.redirect('/es/acceder/');

const t = copy[locale as Locale];
---
<BaseLayout title={`EthicApp | ${t.accessTitle}`}>
  <TopNav locale={locale} nav={t.nav} />

  <main class="mx-auto max-w-4xl px-6 py-16">
    <section class="rounded-xl border border-slate-200 bg-white p-8 shadow-sm">
      <p class="text-sm font-semibold uppercase tracking-wide text-blue-700">EthicApp</p>
      <h1 class="mt-3 text-4xl font-bold leading-tight text-slate-950">{t.accessTitle}</h1>
      <p class="mt-5 text-xl leading-8 text-slate-700">{t.accessLead}</p>
      <p class="mt-4 text-lg leading-8 text-slate-600">
        {t.accessBody}{' '}
        <a class="font-semibold underline" href={`/${locale}/#equipo`}>{t.accessTeamLabel}</a>.
      </p>

      <div class="mt-8 flex flex-wrap gap-3">
        <a
          class="inline-flex items-center rounded-md bg-blue-700 px-5 py-3 text-sm font-semibold !text-white shadow-sm transition hover:bg-blue-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-700"
          href="https://platform.ethicapp.info"
        >
          {t.accessContinueLabel}
        </a>
      </div>
    </section>
  </main>
</BaseLayout>
