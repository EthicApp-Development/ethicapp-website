---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { copy, locales, type Locale } from '../../../lib/i18n';
import TopNav from '../../../components/TopNav.astro';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params;
const posts = (await getCollection('blog', ({ data }) => data.locale === locale && !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---
<BaseLayout title={`Blog | ${locale}`}>
  <TopNav locale={locale} nav={copy[(locale as Locale)].nav} />
  <main class="mx-auto max-w-4xl px-6 py-12">
    <h1 class="text-4xl font-bold">Blog</h1>
    <ul class="mt-8 space-y-5">
      {posts.map((post) => (
        <li class="rounded-lg bg-white p-5 shadow-sm">
          <a class="text-2xl font-semibold text-blue-700" href={`/${locale}/blog/${post.id}/`}>{post.data.title}</a>
          <p class="mt-2 text-slate-600">{post.data.pubDate.toLocaleDateString()}</p>
          <p class="mt-2 text-slate-600">{post.data.description}</p>
        </li>
      ))}
    </ul>
  </main>
</BaseLayout>
