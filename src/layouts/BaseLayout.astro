---
import '../styles/theme.css';

const { title = 'EthicApp v2' } = Astro.props;
import favicon96 from '/assets/favicon/favicon-96x96.png';
import faviconsvg from '/assets/favicon/favicon.svg';
import favicon from '/assets/favicon/favicon.ico';
import appleTouchIcon from '/assets/favicon/apple-touch-icon.png';
import siteWebmanifest from '/assets/favicon/site.webmanifest';

---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet" />

    <link rel="icon" type="image/png" href={favicon96.src} sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href={faviconsvg.src} />
    <link rel="shortcut icon" href={favicon.src} />
    <link rel="apple-touch-icon" sizes="180x180" href={appleTouchIcon.src} />
    <link rel="manifest" href={siteWebmanifest.src} />
  </head>
  <body class="bg-slate-50 font-sans text-slate-900">
    <slot />
  </body>
</html>
